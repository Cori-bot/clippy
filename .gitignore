/target

# release artifacts (ship-zip.ps1, build-installer.ps1 write here)
/dist

# brainstorming mockups (superpowers visual companion)
/.superpowers

# probe/recording artifacts
*.mp4
*.wav
*.png

# the clippy-ui app icon and its generated icon set are shipped, not probed --
# un-ignore them from the *.png rule above.
!/crates/clippy-ui/icon-source.png
!/crates/clippy-ui/icons/**/*.png

# the brand artwork the app icon is cut from -- shipped, not probed.
!/assets/*.png

# the built-in clip-saved and screenshot-saved sounds are shipped, not
# probed -- un-ignore them from the *.wav rule above.
!/crates/clippy-daemon/assets/clip.wav
!/crates/clippy-daemon/assets/shot.wav

/crates/clippy-ui/web/node_modules
/crates/clippy-ui/web/dist
/crates/clippy-ui/gen

# the graphify knowledge graph -- generated from this repo's own sources,
# rebuilt on demand with /graphify.
/graphify-out
.claude-session.tmp
/.test-tmp
/.impeccable
